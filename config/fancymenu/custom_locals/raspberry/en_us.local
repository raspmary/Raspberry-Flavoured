rf.menu.warning.done=Got it - let's play!
rf.menu.createworldscreen.bonuschest=If enabled, will generate%n%a chest with some helpful%n%items near your spawn point,%n%including a guaranteed compass%n%for easier navigation.
rf.menu.createworldscreen.datapack=Modifying data packs is NOT%n%recommended. Proceed with caution.
rf.menu.createworldscreen.difficulty=&l&nDifficulty Settings%n%%n%&b&lPeaceful: &rHostile mobs will not spawn,%n%neutral mobs will become passive%n%&a&lEasy: &rMost hostile mobs will become%n%neutral, mobs' attack damage is lowered%n%&e&lNormal: &rNo adjustments to gameplay%n%behaviour or values%n%&c&lHard: &rMobs' attack damage is increased,%n%certain mobs will behave slightly differently,%n%starvation will lead to death
rf.menu.createworldscreen.survival=&6&l&nSurvival Mode%n%%n%Explore a mysterious world %n%where you build, collect, craft, %n%and fight monsters.
rf.menu.createworldscreen.hardcore=&4&l&nHardcore Mode%n%%n%Same as Survival Mode but locked %n%to Hard difficulty, and if you die%n%even once, it's &lgame over!
rf.menu.createworldscreen.structures=If enabled, structures such as%n%dungeons and mineshafts%n%will generate in the world.
rf.menu.createworldscreen.worldtype=WARNING: It is not recommended%n%to use world types other than%n%Default, as this modpack has%n%custom terrain generation that%n%does not function well with%n%other world types.
rf.menu.createworldscreen.creative=&d&l&nCreative Mode%n%%n%Create, build, and explore without limits. %n%You can fly, have endless materials, %n%and can't be hurt by monsters.
